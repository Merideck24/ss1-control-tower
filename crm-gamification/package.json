{
  "name": "ss1-crm-gamification",
  "version": "0.1.0",
  "private": true,
  "description": "SS1 CRM, Gamificación e IA — MVP: perfil 360, segmentos, recorridos, políticas, recompensas idempotentes, fidelidad y copiloto con permisos acotados.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "CRM_DEV_AUTH=1 node src/api/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p integrations/ss1-admin",
    "build:static": "node scripts/build-static.mjs",
    "db:migrate": "node src/persistence/migrate.ts",
    "openapi": "node scripts/openapi.ts",
    "admin:client": "node scripts/admin-client.ts",
    "test:db": "node --test test/db_postgres.test.ts",
    "start:prod": "node src/api/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@vue/compiler-sfc": "^3.5.46",
    "@vue/server-renderer": "^3.5.46",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3",
    "vue": "^3.5.46",
    "vuetify": "^3.13.8"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "pg": "^8.23.1"
  }
}
